# --- app ---
APP_ENV=production
# Comma-separated: deployed frontend + local dev
ALLOWED_ORIGINS=https://edusphere-web.onrender.com,http://localhost:5173
# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=

# --- Aiven MySQL ---
DB_DRIVER=mysql
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=16450
DB_USER=avnadmin
DB_PASSWORD=your-password
DB_NAME=edusphere
DB_CHARSET=utf8mb4
# Path where the Aiven CA cert is mounted (Render secret file)
DB_SSL_CA=/etc/ssl/aiven/ca.pem

# --- optional integrations (demo mode without them) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Use tls for STARTTLS, ssl for implicit TLS, or none for unencrypted SMTP.
SMTP_SECURE=tls
MAIL_FROM_ADDRESS=noreply@edusphere.dev
MAIL_FROM_NAME=EduSphere
JUDGE0_URL=
JUDGE0_API_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
