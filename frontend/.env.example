DB_DRIVER=mysql
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=15581
DB_USER=avnadmin
DB_PASSWORD=replace-me
DB_NAME=defaultdb
DB_CHARSET=utf8mb4
# Set this to the path of the downloaded Aiven CA certificate for TLS verification.
# DB_SSL_CA=C:\path\to\ca.pem

JWT_SECRET=replace-with-a-long-random-string
ALLOWED_ORIGINS=http://localhost:3000

# SMTP for Next.js email verification and notifications.
# Copy these values to backend/.env too if using the PHP API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Use tls for STARTTLS, ssl for implicit TLS, or none for unencrypted SMTP.
SMTP_SECURE=tls
MAIL_FROM=EduSphere <your-verified-sender@example.com>

# Optional LavaLust API base URL (for example http://localhost:8080).
# Leave blank to use the Next.js API routes. The PHP API is not yet feature-parity.
NEXT_PUBLIC_API_BASE_URL=

# Google OAuth sign-in (must be a real Gmail/Google account).
# Set the public client ID here so the front-end can render the Google button.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional private Judge0 runner for Python, C, C++, and C# free runs and tests.
# Keep these server-side; never expose them with NEXT_PUBLIC_.
# JUDGE0_URL=https://your-private-judge0.example
# JUDGE0_API_KEY=replace-with-your-private-runner-key
